SUPABASE_URL=https://your-project-ref.supabase.co
# Secret/service_role key from Project Settings > API (sb_secret_... or legacy service_role JWT).
# Do NOT use the publishable/anon key here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required. From Project Settings > Database > Connection string — use the "Session pooler" or
# "Transaction pooler" variant (IPv4-reachable). The direct db.<project-ref>.supabase.co host is
# IPv6-only and will fail to resolve from most networks/hosts.
SUPABASE_DB_URL=postgresql+psycopg2://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440